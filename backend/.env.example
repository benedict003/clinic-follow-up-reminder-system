PORT=3400
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=clinic_followup_lab

# Bounded integration settings
INTEGRATION_ENDPOINT=http://127.0.0.1:4699/notify
INTEGRATION_POLL_MS=2000
INTEGRATION_MAX_ATTEMPTS=4
INTEGRATION_TIMEOUT_MS=3000
INTEGRATION_BACKOFF_MS=500
INTEGRATION_MAX_BACKOFF_MS=4000
INTEGRATION_STUCK_MS=60000

# Dev-only: allow the Flutter dev server on another port. Never in production.
DEV_CORS=false

# Lab account passwords are supplied at run time: $env:LAB_PASSWORD
LAB_PASSWORD=