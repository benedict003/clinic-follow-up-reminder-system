PORT=3400
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=clinic_followup_lab

# Bounded integration settings
INTEGRATION_ENDPOINT=http://127.0.0.1:4699/notify
INTEGRATION_POLL_MS=2000
INTEGRATION_MAX_ATTEMPTS=4
INTEGRATION_TIMEOUT_MS=3000
INTEGRATION_BACKOFF_MS=500
INTEGRATION_MAX_BACKOFF_MS=4000
INTEGRATION_STUCK_MS=60000

# Dev-only: allow the Flutter dev server on another port. Never in production.
DEV_CORS=false

# Lab account passwords are supplied at run time: $env:LAB_PASSWORD
LAB_PASSWORD=

# --- Module 14: secure exchange ---
# Values are file paths only. Key material never enters this file.
SECURE_KEY_DIR=keys

SECURE_SENDER_PRIVATE_KEY=
SECURE_SENDER_PUBLIC_KEY=keys/sender-public.pem
SECURE_RECIPIENT_PUBLIC_KEY=keys/recipient-public.pem
SECURE_RECIPIENT_PRIVATE_KEY=
SECURE_REF_KEY_FILE=keys/ref.key

SECURE_REF_KEY_ID=ref-2026-01
SECURE_KEY_ID=clinic-2026-q4
SECURE_SENDER_NAME=clinic-api
SECURE_RECIPIENT_NAME=records-office

SECURE_PARTNER_URL=https://localhost:4443/receive
SECURE_PARTNER_CA=tls/partner.pem
SECURE_PARTNER_CERT=tls/partner.pem
SECURE_PARTNER_CERT_KEY=tls/partner-key.pem
SECURE_PARTNER_PORT=4443

SECURE_TTL_MS=300000

# ── Module 16: deployment settings ─────────────────────────────────────────
# Identifies which build answered a readiness probe. Set by the deploy step; "dev"
# when unset. Not a secret.
BUILD_ID=

# Rate limits. Per user is the limit a clinician could notice; per address is a
# flood net and must stay well above it, because a clinic behind one NAT shares an
# address. Probes (/api/health, /api/ready, /api/metrics) are never limited.
RATE_LIMIT_USER_PER_MIN=300
RATE_LIMIT_ADDRESS_PER_MIN=3000
RATE_LIMIT_LOGIN_PER_MIN=10

# Set to "off" only to measure without compression. Default: on.
COMPRESSION=
