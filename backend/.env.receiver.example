# Module 14 partner receiver configuration.
#
# Copy to .env.receiver and generate the key material first:
#   cd backend && node scripts/secure-keys.js
#
# .env.receiver is ignored by git: it names private key files and must not be
# committed. Only this example file belongs in the repository.

# The clinic's public key, used to verify the envelope signature.
SECURE_SENDER_PUBLIC_KEY=keys/sender-public.pem

# Who this receiver is.
SECURE_RECIPIENT_NAME=records-office

# The partner's TLS material. The certificate is the partner's own; the key is
# private and never leaves the receiver's environment.
SECURE_PARTNER_CERT=tls/partner.pem
SECURE_PARTNER_CERT_KEY=tls/partner-key.pem
SECURE_PARTNER_PORT=4443

# Envelope validity window, in milliseconds (default 5 minutes).
SECURE_TTL_MS=300000

# The only private key the receiver needs: it opens what the clinic sealed.
SECURE_RECIPIENT_PRIVATE_KEY=keys/recipient-private.pem
